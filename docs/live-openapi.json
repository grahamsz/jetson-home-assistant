{
  "openapi": "3.1.0",
  "info": {
    "title": "Jetson Home live API observations",
    "version": "2026-11-04",
    "description": "Four live-observed operations supplement the 43 app-callsite operations in openapi.json. Energy/current and generic equipment status are additional routes; zone status and heat-pump status extend already documented responses. Nullable energy readings are also informed by the bundled energy types. Observations do not establish all valid fields, values, entitlements, freshness policies, or error responses."
  },
  "servers": [
    {
      "url": "https://autopilot-api.jetsonhome.com"
    }
  ],
  "paths": {
    "/v1/systems/{systemId}/energy/current": {
      "get": {
        "summary": "Current whole-home and per-load power and calendar-day energy",
        "description": "HTTP 200 and this response structure were observed in authorized account reads on November 3\u20134, 2026 (America/Denver). This is a sample-derived description, not a complete vendor contract.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "systemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observed successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedEnergyCurrent"
                }
              }
            }
          }
        },
        "x-evidence": {
          "source": "authorized-live-observation",
          "date": "2026-11-04",
          "account-data-omitted": true
        }
      }
    },
    "/v1/equipment/{equipmentId}/status": {
