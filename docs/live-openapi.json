{
  "openapi": "3.1.0",
  "info": {
    "title": "Jetson Home live API observations",
    "version": "2026-11-04-aq",
    "description": "Six live-observed operations supplement the 43 app-callsite operations in openapi.json. Energy/current, generic equipment status, and the separate zone airQuality/current and airQuality/history endpoints are four additional routes, giving 47 distinct operations overall. Zone status and heat-pump status extend already documented responses. Nullable readings are also informed by bundled types. Observations do not establish all valid fields, values, entitlements, freshness policies, or error responses."
  },
  "servers": [
    {
      "url": "https://autopilot-api.jetsonhome.com"
    }
  ],
  "paths": {
    "/v1/systems/{systemId}/energy/current": {
      "get": {
        "summary": "Current Main and per-load power and calendar-day energy",
        "description": "HTTP 200 and this response structure were observed in authorized account reads on November 3\u20134, 2026 (America/Denver). This is a sample-derived description, not a complete vendor contract.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "systemId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Observed successful JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservedEnergyCurrent"
                }
              }
            }
          }
        },
        "x-evidence": {
          "source": "authorized-live-observation",
          "date": "2026-11-04",
          "account-data-omitted": true
        }
      }
    },
