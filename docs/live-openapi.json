            },
            "additionalProperties": true,
            "required": [
              "date",
              "asOf",
              "totalMainEnergyKwh",
              "loads",
              "residualEnergyKwh"
            ]
          },
          "comparisons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "totalMainEnergyKwh": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "loads": {
                  "type": "object",
                  "description": "Only empty maps were observed here; entry shape is not established.",
                  "additionalProperties": true
                },
                "residualEnergyKwh": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "additionalProperties": true,
              "required": [
                "key",
                "date",
                "totalMainEnergyKwh",
                "loads",
                "residualEnergyKwh"
              ]
            }
          }
        },
        "additionalProperties": true,
        "required": [
          "timezone",
          "loads",
          "live",
          "today",
          "comparisons"
        ]
      },
      "ObservedHeatPumpStatus": {
        "type": "object",
