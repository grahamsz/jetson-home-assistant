{
  "config": {
    "step": {
      "user": {
        "title": "Connect Jetson Home",
        "description": "Use the email address registered in the Jetson Home app. Continuing requests a sign-in email from Jetson.",
        "data": {
          "email": "Email address"
        }
      },
      "magic_link": {
        "title": "Verify your sign-in",
        "description": "Jetson sent a link to {email}. Copy the sign-in link from the email without opening it, then paste it here. You can also paste only its token parameter. Links may expire or be single use. This integration requires Jetson's cloud.",
        "data": {
          "magic_link": "Sign-in link or token"
        }
      },
      "reauth_confirm": {
        "title": "Sign in to Jetson Home again",
        "description": "Continue to request a new sign-in email for {email}."
      }
    },
    "error": {
      "cannot_connect": "Jetson could not be reached or returned an unexpected response. Try again. If the sign-in link expired, restart setup for a new email.",
      "invalid_auth": "The sign-in link or token was rejected. Use a fresh link for the same email address.",
      "invalid_email": "Enter a valid email address."
    },
    "abort": {
      "already_configured": "This Jetson account is already configured.",
      "wrong_account": "Sign in with the same Jetson account used for this integration.",
      "reauth_successful": "Jetson Home sign-in updated."
    }
  },
  "options": {
    "error": {
      "invalid_interval": "Enter a whole number from 30 to 900 seconds.",
      "cannot_refresh": "Jetson could not be reached or returned an unexpected response. The previous configuration is kept. Submit to retry.",
      "refresh_incomplete": "Some equipment or hub details could not be refreshed. Available readings continue to update. Submit to retry.",
      "not_loaded": "Load or reload the Jetson Home integration before refreshing its configuration."
    },
    "abort": {
      "configuration_refreshed": "Jetson Home configuration refreshed. Systems, hubs, equipment, and zones have been checked for changes.",
      "reauth_required": "Sign in to Jetson Home again, then refresh configuration."
    },
    "step": {
      "init": {
        "title": "Jetson Home options",
        "menu_options": {
          "polling": "Polling interval",
          "refresh_configuration": "Refresh configuration"
        }
      },
      "polling": {
        "title": "Polling interval",
        "description": "Update known zones, available air quality, power/energy readings, and heat-pump operation every 30 to 900 seconds. Equipment connection status is checked with the next update once five minutes have passed. Use Refresh configuration after changing installed equipment or zones.",
        "data": {
          "scan_interval": "Polling interval (seconds)"
        }
      },
      "refresh_configuration": {
        "title": "Refresh configuration",
        "description": "Check for added, removed, or renamed systems, hubs, equipment, and zones. Your sign-in and polling settings are kept."
      }
    }
